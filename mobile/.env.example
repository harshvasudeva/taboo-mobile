# Signaling Cloudflare Worker base URL (no trailing slash).
# Local wrangler dev:            http://localhost:8787
# Android emulator → host:       http://10.0.2.2:8787
# iOS simulator → host machine:  http://localhost:8787
# Physical devices:              use your LAN IP, e.g. http://192.168.1.20:8787
# Production:                    https://taboo-signaling.ishpreet.workers.dev
EXPO_PUBLIC_SIGNALING_URL=https://taboo-signaling.ishpreet.workers.dev

# STUN server(s), comma separated. Public Google STUN is fine for dev.
EXPO_PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# TURN fallback for restrictive networks (NAT/firewall blocking direct P2P).
# PRODUCTION SECURITY: never ship long-lived static credentials.
# Use short-lived REST-API-issued time-limited credentials (see docs).
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
